# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: for openai-compat:<model>@<base_url> models (Ollama, vLLM, OpenRouter...)
OPENAI_COMPAT_API_KEY=

# provider:model, comma-separated
AGENT_MODELS=anthropic:claude-opus-5-5,openai:gpt-6-luna
JUDGE_MODELS=anthropic:claude-sonnet-5-5,openai:gpt-6-luna

# Service
SERVICE_URL=http://localhost:8000
ADMIN_TOKEN=change-me
